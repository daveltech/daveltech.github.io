---
import Layout from '@layouts/Layout.astro';
import ContactForm from '@components/contact/ContactForm.astro';
import ContactInfo from '@components/contact/ContactInfo.astro';
import { getLabels } from '@i18n/utils';
export { getStaticPaths } from '@i18n/utils';

const labels = getLabels(Astro.currentLocale, 'contact');
const contactLabels = getLabels(Astro.currentLocale, 'contactInfo');
---

<Layout description={labels.description} title={labels.title}>
  <section class="pt-16 pb-0 sm:pt-20 sm:pb-0">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
      <div class="flex max-w-3xl flex-col items-start gap-4 sm:gap-6">
        <h1 class="text-left text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl">{contactLabels.heading}</h1>
      </div>
    </div>
  </section>
  <ContactForm />
  <ContactInfo />
</Layout>