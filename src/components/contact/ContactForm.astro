---
import { getLabels } from '@i18n/utils';

const labels = getLabels(Astro.currentLocale, 'contactInfo');
---

<section class="py-8 sm:py-12">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="bg-surface card-hover rounded-3xl px-6 py-8 sm:px-8 sm:py-10">
      <h1 class="text-3xl font-semibold leading-tight sm:text-4xl">{labels.heading}</h1>

      <div class="mt-8 space-y-8 text-base leading-relaxed sm:text-lg">
        <div>
          <p class="text-muted text-sm font-semibold uppercase tracking-[0.18em]">{labels.companyTitle}</p>
          <p class="mt-3 text-lg font-medium sm:text-xl">{labels.companyName}</p>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(labels.companyAddress)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-link text-primary-600 dark:text-primary-400 mt-1 inline-flex font-medium underline decoration-2 underline-offset-4"
          >
            {labels.companyAddress}
          </a>
        </div>

        <div>
          <p class="text-muted text-sm font-semibold uppercase tracking-[0.18em]">{labels.billingTitle}</p>
          <p class="mt-3">{labels.companyIco}</p>
          <p class="mt-1">{labels.companyDic}</p>
        </div>

        <div>
          <p class="text-muted text-sm font-semibold uppercase tracking-[0.18em]">{labels.contactsTitle}</p>
          <p class="mt-3 font-medium">{labels.contactPerson}</p>
          <p>{labels.contactRole}</p>
          <p class="mt-3">
            <span class="font-medium">{labels.phoneTitle}:</span>
            <a
              href={`tel:${labels.phone}`}
              class="text-link text-primary-600 dark:text-primary-400 ml-2 font-medium underline decoration-2 underline-offset-4"
            >
              {labels.phone}
            </a>
          </p>
          <p class="mt-1">
            <span class="font-medium">{labels.emailTitle}:</span>
            <a
              href={`mailto:${labels.email}`}
              class="text-link text-primary-600 dark:text-primary-400 ml-2 font-medium underline decoration-2 underline-offset-4"
            >
              {labels.email}
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>