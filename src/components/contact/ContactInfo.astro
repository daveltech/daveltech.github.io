---
import WhatsAppIcon from '@assets/icons/whatsapp.svg';
import TelegramAppIcon from '@assets/icons/telegram.svg';
import MessengerAppIcon from '@assets/icons/messenger.svg';
import { getLabels } from '@i18n/utils';

const labels = getLabels(Astro.currentLocale, 'contactInfo');

const contactLinks = [
  {
    name: labels.whatsapp,
    href: labels.whatsappUrl,
    icon: WhatsAppIcon,
  },
  {
    name: labels.telegram,
    href: labels.telegramUrl,
    icon: TelegramAppIcon,
  },
  {
    name: labels.messenger,
    href: labels.messengerUrl,
    icon: MessengerAppIcon,
  },
];
---

<section class="py-8 sm:py-12">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <dl class="grid gap-6 lg:grid-cols-3">
      {contactLinks.map(({ name, href, icon: Icon }) => (
        <div class="bg-surface card-hover rounded-3xl px-6 py-8">
          <dt class="sr-only">{name}</dt>
          <dd class="flex h-full items-center justify-center">
            <a href={href} class="text-link flex flex-col items-center gap-4" target="_blank" rel="noopener noreferrer">
              <Icon class="icon-primary h-14 w-14 shrink-0" aria-hidden="true" />
              <span class="text-base font-medium uppercase tracking-[0.12em]">{name}</span>
            </a>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>