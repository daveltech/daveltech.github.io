---
import { Image } from 'astro:assets';
import missionImg from '@assets/electro-2.webp';
import CrosshairIcon from '@assets/icons/crosshair-2-line.svg';
import { getLabels } from '@i18n/utils';

const labels = getLabels(Astro.currentLocale, 'aboutMission');
---

<section class="pb-16 sm:pb-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
      <Image class="h-auto w-full rounded-3xl" src={missionImg} alt={labels.aboutImgAlt} priority />
      <div class="flex flex-col gap-8 sm:gap-12">
        <div class="flex gap-4">
          <CrosshairIcon class="fill-primary-500 h-8 w-8 shrink-0 sm:h-10 sm:w-10" aria-hidden="true" />
          <h2 class="text-3xl font-semibold leading-tight sm:text-4xl">{labels.title}</h2>
        </div>
        <div class="space-y-6">
          <p class="text-muted text-base leading-relaxed sm:text-lg" set:html={labels.p1} />
          <p class="text-muted text-base leading-relaxed sm:text-lg">{labels.p2}</p>
          <p class="text-muted text-base leading-relaxed sm:text-lg">{labels.p3}</p>
        </div>
      </div>
    </div>
  </div>
</section>
