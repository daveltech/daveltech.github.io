---
import { getLabels } from '@i18n/utils';

const labels = getLabels(Astro.currentLocale, 'aboutHeading');
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex max-w-3xl flex-col items-start gap-4 sm:gap-6">
      <h1 class="text-left text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl">{labels.title}</h1>
      <p class="text-muted text-left text-lg leading-relaxed sm:text-xl">{labels.description}</p>
    </div>
  </div>
</section>
